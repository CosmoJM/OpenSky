{
  "_readme": "OpenSky settings. Copy this file to opensky.json and edit it (a phone setup page will do this for you later). No passwords or API keys here — those go in secrets.json.",

  "family": {
    "name": "Our Family"
  },

  "locale": {
    "language": "en",
    "locale": "en-US",
    "timeFormat": 12,
    "units": "imperial",
    "firstDayOfWeek": 0
  },

  "location": {
    "name": "",
    "latitude": null,
    "longitude": null
  },

  "weather": {
    "provider": "open-meteo"
  },

  "header": {
    "holidays": "US",
    "occasions": [],
    "birthdaysFromCalendar": true,
    "sports": { "league": "nfl", "team": "" }
  },

  "pages": ["home", "calendar", "timer"],

  "calendar": {
    "sources": [
      { "name": "Family", "type": "local", "color": "blue" }
    ],
    "holidays": "US",
    "colors": { "calendars": {}, "rules": [] }
  },

  "photos": {
    "provider": "folder",
    "folder": "~/Pictures",
    "usb": true,
    "intervalSeconds": 30
  },

  "pickup": {
    "trashDay": "",
    "preset": ""
  },

  "sidebar": {
    "idleReturnMinutes": 5
  },

  "timer": {
    "quickAddMinutes": [5, 10, 15, 30, 45, 60],
    "chimeVolume": 0.6
  }
}
