#!/bin/bash
# The `opensky` command (install.sh links it to ~/.local/bin/opensky).
REPO="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
RUNTIME="${OPENSKY_HOME:-$HOME/.local/share/opensky}"
CONFIG="$REPO/config"
PREV="$CONFIG/.previous-version"
# tests swap these: OPENSKY_UPDATE_INSTALL (default: ./install.sh --yes + restart), OPENSKY_HEALTH_CMD, OPENSKY_HEALTH_WAIT
install_and_restart() { if [ -n "${OPENSKY_UPDATE_INSTALL:-}" ]; then sh -c "$OPENSKY_UPDATE_INSTALL"; else ./install.sh --yes && "$0" restart; fi; }
# OpenSky is healthy when its service runs and the screen's web server answers
healthy() {
  if [ -n "${OPENSKY_HEALTH_CMD:-}" ]; then sh -c "$OPENSKY_HEALTH_CMD"; return; fi
  systemctl --user is-active -q opensky.service && curl -fs -o /dev/null --max-time 5 "http://localhost:${OPENSKY_PORT:-8080}/"
}
wait_healthy() {
  local i
  for i in $(seq 1 "${OPENSKY_HEALTH_WAIT:-30}"); do healthy && return 0; sleep 3; done
  return 1
}

# Which version "the newest OpenSky" is: the newest release tag (v…) by default, or the newest commit on main when
# opensky.json → update.channel is "main" (for testers).
channel() { python3 -c 'import json,sys; print(((json.load(open(sys.argv[1])).get("update") or {}).get("channel")) or "releases")' "$CONFIG/opensky.json" 2>/dev/null || echo releases; }
latest_tag() { git -c versionsort.suffix=- tag -l 'v[0-9]*' --sort=-v:refname | head -1; }
target() {
  local t
  if [ "$(channel)" != main ] && t=$(latest_tag) && [ -n "$t" ]; then echo "$t"; else echo "origin/main"; fi
}

update() {
  cd "$REPO" || exit 1
  if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
    echo "OpenSky's files were changed by hand here, so it won't update over them:"; git status --short --untracked-files=no
    echo "(Your settings in config/ are fine — they're not part of this check.)"; exit 1
  fi
  local before; before=$(git rev-parse HEAD)
  git fetch -q --tags origin || { echo "Couldn't reach GitHub — try again later."; exit 1; }
  local to; to=$(target)
  if git merge-base --is-ancestor "$to" HEAD; then echo "OpenSky is up to date ($(git describe --tags --always))."; exit 0; fi
  echo "$before" > "$PREV"
  echo "Updating OpenSky to $to…"
  git checkout -q --detach "$to" || { echo "Couldn't update."; exit 1; }
  if install_and_restart && wait_healthy; then
    echo "Updated to $(git describe --tags --always) ✓  (if anything is wrong: opensky rollback)"
  else
    echo "The new version didn't start properly — going back to the previous one."
    git checkout -q --detach "$before" && install_and_restart && wait_healthy && echo "Back on the previous version ✓" || echo "Still not starting — see: opensky logs"
    exit 1
  fi
}

rollback() {
  cd "$REPO" || exit 1
  [ -f "$PREV" ] || { echo "No earlier version to go back to."; exit 1; }
  local to; to=$(cat "$PREV")
  git cat-file -e "$to^{commit}" 2>/dev/null || { echo "The earlier version isn't available any more."; exit 1; }
  git rev-parse HEAD > "$PREV.undo"
  echo "Going back to the previous version…"
  git checkout -q --detach "$to" && install_and_restart && echo "Back on $(git describe --tags --always) ✓  ('opensky update' brings the newest again)"
}

case "${1:-help}" in
  start)   systemctl --user import-environment WAYLAND_DISPLAY DISPLAY XDG_RUNTIME_DIR XDG_SESSION_TYPE 2>/dev/null
           systemctl --user start opensky-calendar.service opensky.service ;;
  stop)    systemctl --user stop opensky.service ;;
  restart) systemctl --user import-environment WAYLAND_DISPLAY DISPLAY XDG_RUNTIME_DIR XDG_SESSION_TYPE 2>/dev/null
           systemctl --user restart opensky-calendar.service opensky.service ;;
  status)  systemctl --user --no-pager status opensky.service opensky-calendar.service | grep -E "●|Active:|Main PID" ;;
  logs)    # (on Raspberry Pi OS a user service's log lives in the system journal, which the default user can read)
           out=$(journalctl _SYSTEMD_USER_UNIT=opensky.service + _SYSTEMD_USER_UNIT=opensky-calendar.service -n "${2:-80}" --no-pager 2>/dev/null)
           if [ -z "$out" ] || [ "$out" = "-- No entries --" ]; then out=$(journalctl --user -u opensky.service -u opensky-calendar.service -n "${2:-80}" --no-pager 2>&1); fi
           echo "$out" ;;
  check)   # settings sanity check: is the JSON valid, what would be shown?
           for f in opensky.json secrets.json; do
             if [ -f "$CONFIG/$f" ]; then
               python3 -m json.tool "$CONFIG/$f" >/dev/null 2>"/tmp/opensky-check.$$" && echo "✓ $f is valid" \
                 || { echo "✗ $f has a mistake: $(tail -1 "/tmp/opensky-check.$$")"; }
               rm -f "/tmp/opensky-check.$$"
             else echo "– $f is missing (run ./install.sh)"; fi
           done ;;
  update)  update ;;
  rollback) rollback ;;
  backup)  # a backup now, to the place chosen in Settings / phone setup (opensky.json → backup)
           export OPENSKY_SETTINGS="$CONFIG/opensky.json" OPENSKY_SECRETS="$CONFIG/secrets.json" \
                  OPENSKY_LOCAL_CALENDAR="$CONFIG/local-calendar.json" OPENSKY_LOCAL_LISTS="$CONFIG/lists.json"
           NODE="$(command -v node || echo "$RUNTIME/node/bin/node")"; [ -x "$NODE" ] || NODE="$RUNTIME/node/bin/node"
           "$NODE" -e 'global.root_path = process.argv[1]; const b = require(process.argv[2]); const s = b.run();
             if (s.ok) console.log("Backed up ✓ " + s.file); else { console.log("Backup failed: " + s.error); process.exit(1); }' "$RUNTIME/MagicMirror" "$REPO/lib/backup.js" ;;
  run)     # run in this terminal (for testing; Ctrl+C to stop)
           export OPENSKY_SETTINGS="$CONFIG/opensky.json" OPENSKY_SECRETS="$CONFIG/secrets.json" \
                  OPENSKY_LOCAL_CALENDAR="$CONFIG/local-calendar.json" OPENSKY_LOCAL_LISTS="$CONFIG/lists.json" \
                  OPENSKY_CALENDAR_CACHE="$CONFIG/calendar-cache"
           OPENSKY_MM="$RUNTIME/MagicMirror" exec "$REPO/tools/opensky-start" ;;
  edit)    "${EDITOR:-nano}" "$CONFIG/opensky.json" && "$0" check && echo "Run 'opensky restart' to see the changes." ;;
  secrets) "${EDITOR:-nano}" "$CONFIG/secrets.json" && "$0" check && echo "Run 'opensky restart' to use them." ;;
  *) cat <<EOF
opensky — your family screen
  opensky restart      apply changed settings (or after an update)
  opensky start|stop   show / close the screen
  opensky status       is it running?
  opensky logs [N]     the last N lines of its log (default 80)
  opensky edit         edit settings (config/opensky.json), then check them
  opensky secrets      edit passwords and keys (config/secrets.json)
  opensky check        check the settings files for typos
  opensky update       get the newest OpenSky and restart (goes back by itself if it doesn't start)
  opensky rollback     go back to the version before the last update
  opensky backup       make a backup now (to the place chosen in Settings)
Settings + data: $CONFIG
EOF
esac
